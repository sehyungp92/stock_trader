# Runtime mode: dev | backtest | paper | live
ALGO_TRADER_ENV=paper

# Shared PostgreSQL from the swing_trader VPS stack
DB_HOST=trading_postgres
DB_PORT=5432
DB_NAME=trading
DB_USER=trading_writer
DB_PASSWORD=

# Shared IB Gateway running on the VPS host
IB_HOST=host.docker.internal
IB_PORT=4002
IB_ACCOUNT_ID=

# Unique client IDs for this repo's two strategy containers
IB_CLIENT_ID_IARIC=31
IB_CLIENT_ID_US_ORB=32

# Deployment mode and capital split for the two live strategies
STOCK_TRADER_DEPLOY_MODE=both
STOCK_TRADER_CAPITAL_ALLOCATION_IARIC_PCT=50
STOCK_TRADER_CAPITAL_ALLOCATION_US_ORB_PCT=50

# Standardized instrumentation relay endpoint on the same VPS host
INSTRUMENTATION_RELAY_URL=http://host.docker.internal:8001/events
INSTRUMENTATION_HMAC_SECRET=

# Optional experiment metadata
EXPERIMENT_ID=
EXPERIMENT_VARIANT=
